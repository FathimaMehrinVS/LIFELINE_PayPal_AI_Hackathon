# Copy this file to .env and fill in real values. Never commit .env.

# --- API server ---
PORT=4000
WEB_ORIGIN=http://localhost:3000

# --- Web app ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Database (Supabase PostgreSQL) ---
# Supabase dashboard → Connect. DATABASE_URL = transaction pooler (6543), DIRECT_URL = session/direct (5432).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Supabase Auth (server-side API verification; never use a service-role key in the browser) ---
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=

# --- LLM (shared client in apps/api/src/ai) ---
# Primary provider: groq or gemini. The other one is used as fallback when its key and model are set.
LLM_PROVIDER=groq
# https://console.groq.com — pick a current model from the Groq models page
GROQ_API_KEY=
GROQ_MODEL=
# https://aistudio.google.com — pick a current free-tier model
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Channel3 (product discovery) ---
CHANNEL3_API_KEY=

# --- PayPal Sandbox ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
