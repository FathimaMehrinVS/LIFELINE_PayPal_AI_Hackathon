# Copy this file to .env and fill in real values. Never commit .env.

# --- API server ---
PORT=4000
WEB_ORIGIN=http://localhost:3000

# --- Web app ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lifeline?schema=public

# --- Groq (Situation Agent LLM) ---
GROQ_API_KEY=
GROQ_MODEL=

# --- PayPal Sandbox ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
