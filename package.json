{
  "name": "lifeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-Powered Humanitarian Financial Access and Payment Coordination Network",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @lifeline/api\" \"npm run dev -w @lifeline/web\"",
    "dev:api": "npm run dev -w @lifeline/api",
    "dev:web": "npm run dev -w @lifeline/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.9",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
