// Shared database schema (PostgreSQL on Supabase).
// Changes go through a small PR to main, not inside a feature branch.
// Money columns use Decimal(12, 2) to match AmountSchema in packages/contracts.
// The internal ledger is an accounting record, never a PayPal balance.

generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Shared ──────────────────────────────────────────────────────────────

enum Role {
  DONOR
  RECIPIENT
  NGO
  MERCHANT
  PARTNER
}

/// Application profile linked to Supabase Auth when authUserId is populated.
model User {
  id         String   @id @default(cuid())
  authUserId String?  @unique
  name       String
  email      String   @unique
  role       Role?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt @default(now())

  campaigns   Campaign[]
  donations   Donation[]
  allocations AidAllocation[] @relation("ApprovedBy")
  auditLogs   AuditLog[]
  fulfilmentEvents FulfilmentEvent[]
  requests    AssistanceRequest[] @relation("RequestCreator")
}

model Campaign {
  id          String   @id @default(cuid())
  title       String
  description String
  currency    String   @db.Char(3)
  goalAmount  Decimal  @db.Decimal(12, 2)
  active      Boolean  @default(true)
  ownerId     String
  createdAt   DateTime @default(now())

  owner       User            @relation(fields: [ownerId], references: [id])
  donations   Donation[]
  allocations AidAllocation[]
}

enum RequestStatus {
  RECEIVED
  ANALYZED
  ROUTED
  BASKET_READY
  AWAITING_APPROVAL
  APPROVED
  COMPLETED
  REJECTED
}

/// One help request; every module's output hangs off this.
model AssistanceRequest {
  id        String        @id @default(cuid())
  message   String
  location  String?
  currency  String?       @db.Char(3)
  status    RequestStatus @default(RECEIVED)
  createdById String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  situation  SituationAssessment?
  financial  FinancialAssessment?
  basket     Basket?
  allocation AidAllocation?
  createdBy  User? @relation("RequestCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

// ─── Member 1: Situation Intelligence ───────────────────────────────────

enum Urgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model SituationAssessment {
  id                 String   @id @default(cuid())
  requestId          String   @unique
  summary            String
  needs              String[]
  budget             Decimal? @db.Decimal(12, 2)
  currency           String?  @db.Char(3)
  location           String?
  urgency            Urgency
  /// AccessFactors from the contract: { bank_availability: "unavailable", ... }
  access             Json
  missingInformation String[]
  confidence         Float
  createdAt          DateTime @default(now())

  request AssistanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

// ─── Member 2: Financial Intelligence ───────────────────────────────────

model FinancialAssessment {
  id                 String   @id @default(cuid())
  requestId          String   @unique
  recommendedRouteId String?
  currency           String   @db.Char(3)
  /// RouteAssessment[] from the contract, including score breakdown and flags
  routes             Json
  scoreVersion       String
  explanation        String
  createdAt          DateTime @default(now())

  request AssistanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

// ─── Member 3: Commerce Intelligence ────────────────────────────────────

enum SupplierStatus {
  PENDING
  APPROVED
  SUSPENDED
}

/// A supplier. A merchant found through product search stays PENDING until the NGO has checked it.
model Merchant {
  id        String   @id @default(cuid())
  name      String
  location  String
  verified  Boolean  @default(false)
  /// Payment methods the merchant accepts, e.g. ["paypal", "cash"]
  accepts   String[]
  createdAt DateTime @default(now())
  /// NGO decision on this supplier. Only APPROVED suppliers can receive a purchase order.
  status       SupplierStatus @default(PENDING)
  serviceAreas String[]       @default([])
  /// Need categories this supplier can provide, e.g. ["food", "medicine"]
  categories   String[]       @default([])
  contact      String?

  products       Product[]
  purchaseOrders PurchaseOrder[]
  incidents      SupplierIncident[]
}

model Product {
  id           String   @id @default(cuid())
  merchantId   String
  name         String
  description  String
  category     String
  price        Decimal  @db.Decimal(12, 2)
  currency     String   @db.Char(3)
  availability String   @default("available")
  updatedAt    DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([merchantId])
}

model Basket {
  id          String       @id @default(cuid())
  requestId   String       @unique
  total       Decimal      @db.Decimal(12, 2)
  reserve     Decimal      @db.Decimal(12, 2)
  currency    String       @db.Char(3)
  unmetNeeds  String[]
  explanation String
  createdAt   DateTime     @default(now())
  items       BasketItem[]

  request AssistanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model BasketItem {
  id           String  @id @default(cuid())
  basketId     String
  productId    String
  name         String
  category     String
  merchantId   String
  merchantName String
  source       String
  quantity     Int
  unitPrice    Decimal @db.Decimal(12, 2)
  subtotal     Decimal @db.Decimal(12, 2)
  priceLabel   String
  purchaseUrl  String?

  basket Basket @relation(fields: [basketId], references: [id], onDelete: Cascade)

  @@index([basketId])
}

// ─── Money movement (Member 3) ──────────────────────────────────────────
// Donations received, allocations approved and payouts completed are separate states.

enum DonationStatus {
  CREATED
  APPROVED
  CAPTURED
  FAILED
  CANCELLED
  REFUNDED
}

model Donation {
  id              String         @id @default(cuid())
  campaignId      String
  donorId         String?
  amount          Decimal        @db.Decimal(12, 2)
  currency        String         @db.Char(3)
  status          DonationStatus @default(CREATED)
  paypalOrderId   String         @unique
  paypalCaptureId String?        @unique
  allocationId    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id])
  donor    User?    @relation(fields: [donorId], references: [id])
  allocation AidAllocation? @relation(fields: [allocationId], references: [id], onDelete: Restrict)

  @@index([allocationId])
}

enum AllocationStatus {
  PROPOSED
  APPROVED
  REJECTED
  DISBURSED
}

/// NGO decision to direct funds to a request. Nothing is paid out without an APPROVED allocation.
model AidAllocation {
  id           String           @id @default(cuid())
  campaignId   String
  requestId    String           @unique
  amount       Decimal          @db.Decimal(12, 2)
  currency     String           @db.Char(3)
  status       AllocationStatus @default(PROPOSED)
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime         @default(now())

  campaign   Campaign          @relation(fields: [campaignId], references: [id])
  request    AssistanceRequest @relation(fields: [requestId], references: [id])
  approvedBy User?             @relation("ApprovedBy", fields: [approvedById], references: [id])
  payouts    Payout[]
  donations  Donation[]
  purchaseOrder PurchaseOrder?
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  RETURNED
}

enum PayoutMode {
  SANDBOX
  SIMULATED
}

model Payout {
  id             String       @id @default(cuid())
  allocationId   String
  amount         Decimal      @db.Decimal(12, 2)
  currency       String       @db.Char(3)
  status         PayoutStatus @default(PENDING)
  /// SIMULATED payouts must be labelled as a demo fallback in the UI.
  mode           PayoutMode
  paypalBatchId  String?
  paypalItemId   String?
  /// Set when this payout is the NGO's payment to a supplier. It is a separate event from the donor's payment.
  purchaseOrderId String?
  /// Payment reference or evidence note, e.g. an invoice number.
  reference       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  allocation    AidAllocation  @relation(fields: [allocationId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  @@index([allocationId])
  @@index([purchaseOrderId])
}

// ─── Procurement and delivery ───────────────────────────────────────────
// A purchase order links the approved plan to the supplier. Line items come from BasketItem and are not stored twice.

enum FulfilmentStatus {
  AWAITING_ACCEPTANCE
  ACCEPTED
  PREPARING
  READY
  DISPATCHED
  HANDED_OVER
  RECIPIENT_CONFIRMED
  ISSUE_REPORTED
}

enum EvidenceType {
  NGO_CONFIRMATION
  SUPPLIER_CONFIRMATION
  PICKUP_CODE
  RECIPIENT_ACKNOWLEDGEMENT
  RECEIPT
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

model PurchaseOrder {
  id               String           @id @default(cuid())
  allocationId     String           @unique
  merchantId       String
  amount           Decimal          @db.Decimal(12, 2)
  currency         String           @db.Char(3)
  /// Current state; FulfilmentEvent holds the full history.
  fulfilmentStatus FulfilmentStatus @default(AWAITING_ACCEPTANCE)
  /// Only a hash is stored; the code itself is shown once.
  pickupCodeHash   String?
  pickupAttempts   Int              @default(0)
  expectedReadyAt  DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  allocation AidAllocation      @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  merchant   Merchant           @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  events     FulfilmentEvent[]
  payouts    Payout[]
  incidents  SupplierIncident[]

  @@index([merchantId])
}

/// Add-only history of a purchase order. Events are never edited or deleted.
model FulfilmentEvent {
  id              String           @id @default(cuid())
  purchaseOrderId String
  status          FulfilmentStatus
  actorId         String?
  evidenceType    EvidenceType?
  note            String?
  createdAt       DateTime         @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  actor         User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId, createdAt])
}

model SupplierIncident {
  id              String           @id @default(cuid())
  merchantId      String
  purchaseOrderId String?
  severity        IncidentSeverity
  description     String
  status          IncidentStatus   @default(OPEN)
  createdAt       DateTime         @default(now())
  resolvedAt      DateTime?

  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@index([merchantId, status])
}

/// Every PayPal webhook received. The unique eventId stops duplicate events from being processed twice.
model WebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  eventType   String
  verified    Boolean
  payload     Json
  processedAt DateTime?
  receivedAt  DateTime  @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
}
