// Shared database schema. Changes go through a small PR to main, not inside a feature branch.
// Money columns use Decimal(12, 2) to match AmountSchema in packages/contracts.

generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  RECEIVED
  ANALYZED
  ROUTED
  BASKET_READY
  PAYMENT_PENDING
  COMPLETED
  FAILED
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PaymentStatus {
  CREATED
  APPROVED
  CAPTURED
  FAILED
  CANCELLED
}

/// One help request from a user; every module's output hangs off this.
model Request {
  id        String        @id @default(cuid())
  message   String
  location  String?
  currency  String?       @db.Char(3)
  status    RequestStatus @default(RECEIVED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  situation           Situation?
  financialAssessment FinancialAssessment?
  basket              Basket?
  payments            Payment[]
}

/// Member 1 — output of the Situation Agent.
model Situation {
  id                 String   @id @default(cuid())
  requestId          String   @unique
  needs              String[]
  budget             Decimal? @db.Decimal(12, 2)
  currency           String   @db.Char(3)
  location           String?
  urgency            Urgency
  missingInformation String[]
  confidence         Float
  createdAt          DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

/// Member 2 — output of Financial Intelligence.
model FinancialAssessment {
  id                 String   @id @default(cuid())
  requestId          String   @unique
  recommendedRouteId String
  estimatedFee       Decimal  @db.Decimal(12, 2)
  currency           String   @db.Char(3)
  accessibilityScore Int
  riskFlags          Json
  explanation        String
  createdAt          DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

/// Member 3 — basket built by Commerce Intelligence.
model Basket {
  id              String       @id @default(cuid())
  requestId       String       @unique
  total           Decimal      @db.Decimal(12, 2)
  remainingBudget Decimal      @db.Decimal(12, 2)
  currency        String       @db.Char(3)
  createdAt       DateTime     @default(now())
  items           BasketItem[]

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model BasketItem {
  id         String  @id @default(cuid())
  basketId   String
  productId  String
  merchantId String
  name       String
  category   String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  subtotal   Decimal @db.Decimal(12, 2)

  basket Basket @relation(fields: [basketId], references: [id], onDelete: Cascade)

  @@index([basketId])
}

/// Member 3 — PayPal Sandbox payment for a request.
model Payment {
  id              String        @id @default(cuid())
  requestId       String
  provider        String        @default("paypal")
  providerOrderId String?       @unique
  routeId         String
  status          PaymentStatus @default(CREATED)
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @db.Char(3)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}
